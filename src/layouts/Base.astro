---
import '../styles/global.css';
import ThemeDock from '../components/ThemeDock.svelte';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  /** Mount the ambient particle background. */
  particles?: boolean;
}

const { title, description, ogImage = '/og-image.jpg', particles = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImageUrl = new URL(ogImage, Astro.site);
const isHome = Astro.url.pathname === '/';
---

<!doctype html>
<html lang="en" data-theme="cookie">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <!-- Apply the saved palette before first paint so dark themes don't flash cream.
         Keep in sync with THEMES / onAccentFor in ThemeDock.svelte. -->
    <script is:inline>
      (function () {
        try {
          var saved = JSON.parse(localStorage.getItem('jw-palette') || 'null');
          if (!saved) return;
          var ids = ['cookie', 'lab', 'editorial', 'forest'];
          var root = document.documentElement;
          if (ids.indexOf(saved.id) !== -1) root.dataset.theme = saved.id;
          if (saved.customAccent && /^#[0-9a-f]{6}$/i.test(saved.customAccent)) {
            var hex = saved.customAccent;
            var lum = [1, 3, 5].map(function (i) {
              var c = parseInt(hex.substr(i, 2), 16) / 255;
              return c <= 0.03928 ? c / 12.92 : Math.pow((c + 0.055) / 1.055, 2.4);
            });
            var L = 0.2126 * lum[0] + 0.7152 * lum[1] + 0.0722 * lum[2];
            root.style.setProperty('--accent-color', hex);
            root.style.setProperty('--on-accent', L > 0.4 ? '#1C1C1A' : '#FFFFFF');
          }
        } catch (e) {}
      })();
    </script>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Rubik:wght@400;500;600;700;800&display=swap" rel="stylesheet" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="jasonwride.studio" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <slot name="head" />
  </head>
  <body>
    {particles && <canvas id="particles-bg" aria-hidden="true"></canvas>}

    <nav class="navbar" aria-label="Main">
      <a href="/" class="logo">jasonwride<span class="dot">.studio</span></a>
      <div class="nav-links">
        <a href={isHome ? '#shots' : '/#shots'} class="nav-item">Photos</a>
        <a href={isHome ? '#projects' : '/#projects'} class="nav-item">Projects</a>
        <a href="mailto:jason.wride@utah.edu" class="nav-item contact-pill">Hi! <span aria-hidden="true">👋</span></a>
      </div>
    </nav>

    <slot />

    <footer>
      <p>&copy; {new Date().getFullYear()} Jason Wride. All rights reserved.</p>
      <p class="footer-stack">
        Built with <span>Astro</span>, <span>Svelte</span> &amp; <span>WebGL</span>.
      </p>
    </footer>

    <ThemeDock client:idle />

    {particles && (
      <script>
        import { startParticles } from '../scripts/particles';
        const canvas = document.getElementById('particles-bg');
        if (canvas instanceof HTMLCanvasElement) startParticles(canvas);
      </script>
    )}
  </body>
</html>
