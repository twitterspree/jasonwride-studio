---
import { CONCEPTS } from '../data/concepts';

interface Props {
  title: string;
  /** Google Fonts css2 query, e.g. "family=Fraunces:opsz,wght@9..144,300..900" */
  fonts: string;
  current: string;
  /** Where the concept switcher pill sits, so it doesn't cover a page's own controls */
  dock?: 'bottom' | 'top';
}
const { title, fonts, current, dock = 'bottom' } = Astro.props;

const i = CONCEPTS.findIndex((c) => c.id === current);
const prev = CONCEPTS[(i - 1 + CONCEPTS.length) % CONCEPTS.length];
const next = CONCEPTS[(i + 1) % CONCEPTS.length];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>{title} — concept | jasonwride.studio</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href={`https://fonts.googleapis.com/css2?${fonts}&display=swap`} rel="stylesheet" />
  </head>
  <body>
    <slot />

    <nav class={`concept-switcher dock-${dock}`} aria-label="Design concepts">
      <a href={`/concepts/${prev.id}`} class="cs-arrow" aria-label={`Previous concept: ${prev.label}`}>‹</a>
      <a href="/concepts/" class="cs-current" title="All concepts">
        <span class="cs-num">{i + 1}/{CONCEPTS.length}</span> {CONCEPTS[i]?.label ?? title}
      </a>
      <a href={`/concepts/${next.id}`} class="cs-arrow" aria-label={`Next concept: ${next.label}`}>›</a>
    </nav>

    <style is:global>
      * { margin: 0; padding: 0; box-sizing: border-box; }
      img { display: block; max-width: 100%; }
      @media (prefers-reduced-motion: reduce) {
        *, *::before, *::after { animation-duration: 0.01ms !important; transition-duration: 0.01ms !important; }
      }
    </style>

    <style>
      .concept-switcher {
        position: fixed;
        left: 0.75rem;
        z-index: 9000;
        display: flex;
        align-items: center;
        gap: 0.1rem;
        padding: 0.25rem;
        border-radius: 999px;
        background: rgba(17, 17, 17, 0.88);
        backdrop-filter: blur(8px);
        color: #eee;
        font: 500 12px/1 ui-monospace, 'SF Mono', Menlo, monospace;
        box-shadow: 0 6px 24px rgba(0, 0, 0, 0.3);
      }
      .dock-bottom { bottom: 0.75rem; }
      .dock-top { top: 0.75rem; }
      .concept-switcher a {
        color: inherit;
        text-decoration: none;
        padding: 0.45rem 0.7rem;
        border-radius: 999px;
        white-space: nowrap;
      }
      .concept-switcher a:hover { background: #2a2a2a; }
      .cs-arrow { font-size: 15px; padding: 0.35rem 0.6rem !important; }
      .cs-num { opacity: 0.55; margin-right: 0.3rem; }
    </style>
  </body>
</html>
