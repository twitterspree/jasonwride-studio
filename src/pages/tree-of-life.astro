---
import Base from '../layouts/Base.astro';
import RadialTree from '../components/RadialTree.svelte';
import treeData from '../data/tree.json';
import traitInfo from '../data/traits.json';
---

<Base
  title="Tree of Life | Jason Wride"
  description="An interactive radial cladogram of convergent evolution — see which unrelated lineages independently evolved flight, venom, echolocation and more."
>
  <main class="page-main">
    <h1 class="section-title">Convergent Evolution</h1>
    <p class="page-lede">
      A radial tree of life from LUCA to living species. Select a trait to light up every lineage that evolved it
      independently. Hover or tap a species to trace its ancestry.
    </p>

    <RadialTree client:load {treeData} {traitInfo} />
  </main>
</Base>
