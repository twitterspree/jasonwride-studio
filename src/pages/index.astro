---
import { loadPhotos } from '../lib/photos';
import { loadPortrait } from '../lib/portrait';
import Base from '../layouts/Base.astro';
import MarqueeGallery from '../components/MarqueeGallery.svelte';
import DepthProfile from '../components/DepthProfile.svelte';
import DraggableSkills from '../components/DraggableSkills.svelte';

const portrait = await loadPortrait();
const photos = await loadPhotos();
---

<Base
  title="Jason Wride | IS Student & Photographer"
  description="Portfolio of Jason Wride — Information Systems student, developer, and photographer at the University of Utah."
  particles
>
  <link slot="head" rel="preload" as="image" href={portrait.src} fetchpriority="high" />

  <main class="hero-container">
    <div class="hero-content">
      <h1 class="bouncy-name">Hi, I'm Jason Wride.</h1>

      <p class="subtitle">IS Student. Photographer. Creator. University of Utah.</p>
      <p class="intro-text">
        Welcome to my studio. This is where code meets creativity, or whatever it is I waste my time on. Take a look
        around or hmu.
      </p>

      <DraggableSkills client:visible />

      <a href="mailto:jason.wride@utah.edu" class="cta-button">Get in Touch</a>
    </div>

    <div class="hero-image-container">
      <DepthProfile client:load {...portrait} alt="Portrait of Jason Wride" />
    </div>
  </main>

  <section id="shots" class="gallery-section" aria-labelledby="shots-title">
    <h2 id="shots-title" class="section-title">Photo slides...</h2>
    <MarqueeGallery client:visible images={photos} />
  </section>

  <section id="projects" class="projects-section" aria-labelledby="projects-title">
    <h2 id="projects-title" class="section-title">Technical Projects</h2>

    <div class="project-grid">
      <article class="project-card">
        <span class="status-pill status-public">Interactive</span>
        <h3 class="project-title">The Tree of Life</h3>
        <p class="project-desc">
          An interactive radial cladogram mapping convergent evolution — pick a trait like flight or venom and watch
          the unrelated lineages that evolved it light up.
        </p>
        <p class="project-desc">
          Custom recursive layout rendered straight to the HTML5 Canvas API, with no charting library.
        </p>
        <ul class="tech-stack" aria-label="Tech stack">
          <li class="tech-tag">Svelte</li>
          <li class="tech-tag">Canvas API</li>
          <li class="tech-tag">Python</li>
        </ul>
        <a href="/tree-of-life" class="project-link">Explore the Tree &rarr;</a>
      </article>

      <article class="project-card">
        <span class="status-pill status-private">Private Repo</span>
        <h3 class="project-title">Local RAG AI Assistant</h3>
        <p class="project-desc">
          A native macOS/iOS app that leverages local LLMs (via Ollama) to perform Retrieval-Augmented Generation (RAG)
          on iMessage history.
        </p>
        <p class="project-desc">
          Engineered to allow semantic search and "chat with your texts" functionality while maintaining 100% data
          privacy and offline capability.
        </p>
        <ul class="tech-stack" aria-label="Tech stack">
          <li class="tech-tag">SwiftUI</li>
          <li class="tech-tag">Ollama</li>
          <li class="tech-tag">Vector DB</li>
          <li class="tech-tag">Local LLM</li>
        </ul>
      </article>

      <article class="project-card">
        <span class="status-pill status-public">Public Repo</span>
        <h3 class="project-title">JasonWride.Studio</h3>
        <p class="project-desc">
          This site: a static Astro build with Svelte islands, a WebGL depth-mapped portrait, and a themeable design
          system.
        </p>
        <p class="project-desc">Deployed on Cloudflare's edge network, with images optimized at build time.</p>
        <ul class="tech-stack" aria-label="Tech stack">
          <li class="tech-tag">Astro</li>
          <li class="tech-tag">Svelte</li>
          <li class="tech-tag">WebGL</li>
          <li class="tech-tag">TypeScript</li>
        </ul>
        <a href="https://github.com/twitterspree/jasonwride-studio" target="_blank" rel="noopener" class="project-link"
          >View Source Code &rarr;</a
        >
      </article>
    </div>
  </section>
</Base>

<script>
  // Bouncy name: split the heading into letters that wave in, then hop on hover
  const nameEl = document.querySelector<HTMLElement>('.bouncy-name');

  if (nameEl) {
    const text = nameEl.textContent ?? '';
    nameEl.setAttribute('aria-label', text); // the letter spans below are aria-hidden
    nameEl.textContent = '';

    // Letters are grouped per word so lines only break between words
    let i = 0;
    text.split(' ').forEach((word, w, words) => {
      const wordEl = document.createElement('span');
      wordEl.className = 'bouncy-word';
      wordEl.setAttribute('aria-hidden', 'true');

      for (const letter of word) {
        const span = document.createElement('span');
        span.textContent = letter;
        span.className = 'bouncy-letter';
        span.style.animationDelay = `${i++ * 0.05}s`;

        let isRising = false;

        span.addEventListener('mouseenter', () => {
          if (!span.classList.contains('loaded')) return;
          span.classList.add('up');
          isRising = true;
          setTimeout(() => {
            isRising = false;
            if (!span.matches(':hover')) span.classList.remove('up');
          }, 300);
        });

        span.addEventListener('mouseleave', () => {
          if (!isRising) span.classList.remove('up');
        });

        span.addEventListener('animationend', () => {
          span.classList.add('loaded');
          span.style.animationDelay = '0s';
        });

        wordEl.appendChild(span);
      }

      nameEl.appendChild(wordEl);
      if (w < words.length - 1) {
        nameEl.append(' ');
        i++; // keep the wave's rhythm across the space
      }
    });
  }
</script>
