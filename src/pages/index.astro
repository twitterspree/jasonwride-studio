---
// 1. FRONTMATTER: This is where we import styles
import '../styles/global.css';

import Gallery from '../components/Gallery.svelte';

import DepthProfile from '../components/DepthProfile.svelte';

// Let's create some dummy data for now
const myPhotos = [
    { url: 'https://images.unsplash.com/photo-1516035069371-29a1b244cc32?ixlib=rb-4.0.3&auto=format&fit=crop&w=800&q=80', alt: 'Camera' },
    { url: 'https://images.unsplash.com/photo-1500485035595-cbe6f645feb1?ixlib=rb-4.0.3&auto=format&fit=crop&w=800&q=80', alt: 'Canyon' },
    { url: 'https://images.unsplash.com/photo-1447752875215-b2761acb3c5d?ixlib=rb-4.0.3&auto=format&fit=crop&w=800&q=80', alt: 'Leaves' },
    { url: 'https://images.unsplash.com/photo-1470071459604-3b5ec3a7fe05?ixlib=rb-4.0.3&auto=format&fit=crop&w=800&q=80', alt: 'Fog' },
    { url: 'https://images.unsplash.com/photo-1472214103451-9374bd1c798e?ixlib=rb-4.0.3&auto=format&fit=crop&w=800&q=80', alt: 'Grass' },
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Jason Wride | IS Student & Photographer</title>
	<link rel="icon" href="https://fav.farm/🍪" />
    
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Rubik:wght@400;600;800&display=swap" rel="stylesheet">
    
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" integrity="sha512-DTOQO9RWCH3ppGqcWaEA1BIZOC6xxalwEsw9c2QQeAIftl+Vegovlnee1c9QX4TctnWMn13TZye+giMm8e2LwA==" crossorigin="anonymous" referrerpolicy="no-referrer" />
    
    <script is:inline src="https://cdn.jsdelivr.net/npm/tsparticles@2.12.0/tsparticles.bundle.min.js"></script>
  </head>
  <body>

	<nav class="navbar">
    	<div class="logo">jasonwride<span class="dot">.studio</span></div>
    	<div class="nav-links">
        	<a href="https://github.com/twitterspree" target="_blank" class="nav-item">GitHub</a>
       		<a href="https://linkedin.com" target="_blank" class="nav-item">LinkedIn</a>
        	<a href="mailto:jason.wride@utah.edu" class="nav-item contact-pill">Hi! 👋</a>
    	</div>
	</nav>


    <div id="particles-js"></div>

    <main class="hero-container">
        <div class="hero-content">
            <h1 class="bouncy-name">Hi, I'm Jason Wride.</h1>
            
            <h2 class="subtitle">IS Student. 'Photographer'. "Creator". at University of Utah.</h2>
            <p class="intro-text">Welcome to my studio. This is where 'code meets creativity' or whatever it is I waste my time on. Take a look around or hmu.</p>

            <div class="skills-bar">
                <div class="skill-icon-wrapper" data-tooltip="HTML5 Structure">
                    <i class="fab fa-html5 skill-icon html"></i>
                </div>
                <div class="skill-icon-wrapper" data-tooltip="CSS3 Styling">
                    <i class="fab fa-css3-alt skill-icon css"></i>
                </div>
                <div class="skill-icon-wrapper" data-tooltip="JavaScript Logic">
                    <i class="fab fa-js-square skill-icon js"></i>
                </div>
                <div class="skill-icon-wrapper" data-tooltip="Photography & Visuals">
                    <i class="fas fa-camera-retro skill-icon photo"></i>
                </div>
            </div>

            <a href="mailto:jason.wride@utah.edu" class="cta-button">Get in Touch</a>
        </div>

        <div class="hero-image-container tilt-effect">
			<DepthProfile 
				client:load 
				src="/profilepictiny.png" 
				depthSrc="/profile-depthv2.png" 
				alt="Jason Wride Portrait"
			/>
        </div>
    </main>


	<section class="gallery-section">
	    <h2 class="section-title">Selected Shots</h2>

	    <Gallery client:load images={myPhotos} />
	</section>

    <script>
      // --- INTERACTION #3: Particle Background Configuration ---
      // @ts-ignore
      <script>
      // @ts-ignore
      // tsParticles uses ".load" instead of just passing the ID
      tsParticles.load("particles-js", {
        "particles": {
          "number": {
            "value": 60,
            "density": { "enable": true, "value_area": 800 }
          },
          "color": { "value": "#FF9248" },
          "shape": { "type": "circle" },
          "opacity": { "value": 0.2, "random": true },
          "size": { "value": 5, "random": true },
          "move": {
            "enable": true,
            "speed": 1,
            "direction": "none",
            "random": true,
            "straight": false,
            "out_mode": "out",
            "bounce": false
          }
        },
        "interactivity": {
          "detect_on": "window",
          "events": {
            "onhover": { 
                "enable": true, 
                "mode": "bubble" 
            },
            "onclick": { "enable": false },
            "resize": true
          },
          "modes": {
            "bubble": {
              // 1. Start growing from further away (Smoother gradient)
              "distance": 300, 
              
              // 2. Reduce target size drastically
              // Jumping from 5 to 150 is jarring. 5 to 12 is subtle and smooth.
              "size": 8,       
              
              // 3. Remove 'duration'
              // Duration creates a "pulsing" loop (grow-shrink-grow). 
              // Removing it makes it "hold" the size while you hover.
              // "duration": 2, <--- DELETE THIS
              
              "opacity": 0.3,
              "mix": false
            }
          }
        },
        "retina_detect": true
      });

      // --- INTERACTION #1: Bouncy Name Animation ---
      const nameContainer = document.querySelector('.bouncy-name') as HTMLElement;
      
      if (nameContainer) {
          const nameText = nameContainer.textContent || '';
          nameContainer.textContent = '';

          nameText.split('').forEach((letter, i) => {
              const span = document.createElement('span');
              if (letter === ' ') {
                  span.innerHTML = '&nbsp;';
              } else {
                  span.textContent = letter;
              }
              span.classList.add('bouncy-letter');
              span.style.animationDelay = `${i * 0.05}s`;
              
              // --- STATE MANAGEMENT ---
              // Track if the letter is currently in the middle of jumping up
              let isRising = false;

              // 1. Mouse Enter: Trigger the jump
              span.addEventListener('mouseenter', () => {
                  // Only interact if the entrance wave is finished
                  if (span.classList.contains('loaded')) {
                      span.classList.add('up');
                      isRising = true;

                      // Enforce Minimum Rise Time (200ms matches CSS transition)
                      setTimeout(() => {
                          isRising = false;
                          // If the mouse left while we were rising, we come down NOW.
                          if (!span.matches(':hover')) {
                              span.classList.remove('up');
                          }
                      }, 300); 
                  }
              });

              // 2. Mouse Leave: Trigger the fall (maybe)
              span.addEventListener('mouseleave', () => {
                  // If we are currently rising, DO NOTHING. 
                  // The setTimeout above will handle the drop when it finishes.
                  
                  // If we are NOT rising (meaning we are holding at the top), drop immediately.
                  if (!isRising) {
                      span.classList.remove('up');
                  }
              });
              
              // 3. Animation End: Mark as loaded (Existing logic)
              span.addEventListener('animationend', () => {
                  span.classList.add('loaded');
                  span.style.animationDelay = '0s';
              });

              nameContainer.appendChild(span);
          });
      }

      // --- INTERACTION #4: 3D Image Tilt Effect ---
      // Fix: Add 'as HTMLElement' to both selectors
      const tiltContainer = document.querySelector('.tilt-effect') as HTMLElement;
      const tiltImg = tiltContainer?.querySelector('.hero-img') as HTMLElement;

      if (tiltContainer && tiltImg) {
          tiltContainer.addEventListener('mousemove', (e) => {
              const rect = tiltContainer.getBoundingClientRect();
              const width = rect.width;
              const height = rect.height;
              const mouseX = e.clientX - rect.left - width / 2;
              const mouseY = e.clientY - rect.top - height / 2;
              const rotateY = mouseX / 25; 
              const rotateX = mouseY / -25;

              tiltImg.style.transform = `rotateX(${rotateX}deg) rotateY(${rotateY}deg) scale(1.05)`;
          });

          tiltContainer.addEventListener('mouseleave', () => {
              tiltImg.style.transform = 'rotateY(-5deg) rotateX(5deg) scale(1)';
          });
      }
    </script>


    <footer>
        <p>&copy; {new Date().getFullYear()} Jason Wride. All rights reserved.</p>
        <p class="footer-stack">
            Built with <span>Astro</span>, <span>Svelte</span> & <span>WebGL</span>.
        </p>
    </footer>
  </body>
</html>