---
import Concept from '../../layouts/Concept.astro';
import GoldenHour from '../../components/concepts/GoldenHour.svelte';
import { loadPhotos } from '../../lib/photos';
import { loadLandscapes } from '../../lib/landscapes';

const fmt = (d?: string) =>
  d ? new Date(d + 'T12:00:00').toLocaleDateString('en-US', { month: 'short', year: 'numeric' }) : '';

const portraits = (await loadPhotos(600)).map((p) => ({
  id: p.id,
  src: p.full,
  alt: p.alt,
  caption: `${fmt(p.date)} · ${p.exif ?? ''}`,
}));
const landscapes = (await loadLandscapes()).map((l) => ({
  id: l.id,
  src: l.thumb,
  alt: l.alt,
  light: l.light,
  caption: `${l.place} · ${fmt(l.date)} · ${l.exif}`,
}));

const projects = [
  { title: 'Tree of Life', text: 'An interactive radial tree of convergent evolution.', href: '/tree-of-life' },
  { title: 'Local RAG Assistant', text: 'A macOS/iOS app that chats with your texts, fully offline.' },
  { title: 'This website', text: 'Astro + Svelte. It knows where the sun is in Santaquin.', href: 'https://github.com/twitterspree/jasonwride-studio' },
];
---

<Concept title="Golden Hour" current="golden-hour" fonts="family=Newsreader:ital,opsz,wght@0,6..72,300..600;1,6..72,400&family=Karla:wght@400;500;700">
  <GoldenHour client:load {portraits} {landscapes} />

  <section class="projects">
    <h2>Things I build when the light’s bad</h2>
    <div class="cards">
      {projects.map((p) => (
        <article class="card">
          <h3>{p.title}</h3>
          <p>{p.text}</p>
          {p.href && <a href={p.href}>Take a look →</a>}
        </article>
      ))}
    </div>
  </section>

  <footer class="foot">
    <p>Say hi — any time of day.</p>
    <a href="mailto:jason.wride@utah.edu">jason.wride@utah.edu</a>
  </footer>
</Concept>

<style is:global>
  :root {
    --sky-top: #5f9bd8;
    --sky-bot: #dbeafe;
    --ink: #12203a;
    --accent: #1d4ed8;
    --card: rgba(255, 255, 255, 0.5);
  }
  body {
    /* The page below the sky takes the horizon colour of the current light */
    background: var(--sky-bot);
    color: var(--ink);
    font-family: 'Karla', sans-serif;
    transition: background 0.4s, color 0.4s;
  }
  a { color: var(--accent); }
</style>

<style>
  .projects { padding: 2rem clamp(1.25rem, 5vw, 4rem); }
  .projects h2 { font: 400 clamp(1.8rem, 4vw, 2.8rem) 'Newsreader', serif; margin-bottom: 1.5rem; }
  .cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 1.2rem; }
  .card {
    background: var(--card);
    border: 1px solid color-mix(in srgb, var(--ink) 15%, transparent);
    border-radius: 6px;
    padding: 1.4rem;
    backdrop-filter: blur(6px);
  }
  .card h3 { font: 500 1.5rem 'Newsreader', serif; margin-bottom: 0.4rem; }
  .card p { line-height: 1.5; opacity: 0.85; margin-bottom: 0.8rem; }
  .foot { padding: 4rem clamp(1.25rem, 5vw, 4rem) 8rem; text-align: center; }
  .foot p { font: italic 1.3rem 'Newsreader', serif; opacity: 0.8; }
  .foot a { font: 400 clamp(1.8rem, 5vw, 3.2rem) 'Newsreader', serif; }
</style>
