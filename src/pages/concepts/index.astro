---
import { CONCEPTS, ROUNDS } from '../../data/concepts';

const rounds = ([4, 3, 2, 1] as const).map((r) => ({ r, ...ROUNDS[r], items: CONCEPTS.filter((c) => c.round === r) }));
const number = (id: string) => CONCEPTS.findIndex((c) => c.id === id) + 1;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Concepts | jasonwride.studio</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400..800&display=swap" rel="stylesheet" />
  </head>
  <body>
    <main>
      <header>
        <p class="eyebrow">jasonwride.studio · design concepts</p>
        <h1>{CONCEPTS.length} ways this site could go.</h1>
        <p class="lede">Mockups, not finished sites. Newest round first. Nothing here is live on the real site.</p>
      </header>

      {rounds.map((round) => (
        <section>
          <h2>{round.title}</h2>
          <p class="blurb" set:html={round.blurb.replace(/\*(.+?)\*/g, '<em>$1</em>')} />
          <ol>
            {round.items.map((c) => (
              <li>
                <a href={`/concepts/${c.id}`}>
                  <span class="num">{String(number(c.id)).padStart(2, '0')}</span>
                  <span class="name">{c.label}</span>
                  <span class="thesis">{c.thesis}</span>
                  <span class="go" aria-hidden="true">→</span>
                </a>
              </li>
            ))}
          </ol>
        </section>
      ))}

      <footer><a href="/">← Back to the live site</a></footer>
    </main>

    <style>
      * { margin: 0; padding: 0; box-sizing: border-box; }
      body {
        background: #f3f1ec;
        color: #161514;
        font-family: 'Bricolage Grotesque', system-ui, sans-serif;
      }
      main { max-width: 980px; margin: 0 auto; padding: 4rem 1.25rem 6rem; }
      .eyebrow { font-size: 0.8rem; letter-spacing: 0.14em; text-transform: uppercase; color: #77726a; }
      h1 { font-size: clamp(2.6rem, 8vw, 5.4rem); font-weight: 800; line-height: 0.95; letter-spacing: -0.03em; margin: 0.6rem 0 1rem; }
      .lede { font-size: 1.15rem; color: #4d4943; max-width: 52ch; }
      section { margin-top: 3.5rem; }
      h2 { font-size: 1.3rem; font-weight: 700; padding-bottom: 0.4rem; border-bottom: 2px solid #161514; }
      .blurb { color: #77726a; margin: 0.5rem 0 0.8rem; }
      ol { list-style: none; }
      li a {
        display: grid;
        grid-template-columns: 3rem 13rem 1fr auto;
        align-items: baseline;
        gap: 1rem;
        padding: 0.9rem 0.5rem;
        border-bottom: 1px solid #d9d5cd;
        color: inherit;
        text-decoration: none;
        transition: background 0.15s, padding 0.2s;
      }
      li a:hover { background: #161514; color: #f3f1ec; padding-left: 1rem; }
      .num { font-variant-numeric: tabular-nums; color: #9a948a; }
      .name { font-size: 1.35rem; font-weight: 700; }
      .thesis { color: inherit; opacity: 0.75; }
      .go { font-size: 1.2rem; }
      footer { margin-top: 4rem; }
      footer a { color: #161514; }
      @media (max-width: 680px) {
        li a { grid-template-columns: 2.2rem 1fr auto; }
        .thesis { grid-column: 2 / -1; font-size: 0.95rem; }
      }
    </style>
  </body>
</html>
