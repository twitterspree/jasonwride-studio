---
import Concept from '../../layouts/Concept.astro';
import DepthProfile from '../../components/DepthProfile.svelte';
import DraggableSkills from '../../components/DraggableSkills.svelte';
import PinnedSpecimens from '../../components/concepts/PinnedSpecimens.svelte';
import FieldCladogram from '../../components/concepts/FieldCladogram.svelte';
import { loadPhotos, CAMERA, LENS } from '../../lib/photos';
import { loadPortrait } from '../../lib/portrait';
import treeData from '../../data/tree.json';
import traitInfo from '../../data/traits.json';

const photos = await loadPhotos(420);
const portrait = await loadPortrait();

// Mock-Latin field names for each photograph
const names: Record<string, { latin: string; common: string; note?: string }> = {
  IMG_7799: { latin: 'Amantes, oculis tectis', common: 'Couple, eyes covered', note: 'shy specimen. f/1.4!' },
  'IMG_8004-2': { latin: 'Ambulantes aurei', common: 'Golden-path walkers' },
  IMG_8504: { latin: 'Sedentes fluviales', common: 'Riverside sitters', note: 'observed near rushing water' },
  'IMG_8545-2': { latin: 'Contemplatores rivi', common: 'Stream contemplators' },
  'IMG_8686-2': { latin: 'Grex amicorum', common: 'Flock of friends (12)', note: 'rare: a flock of 12!' },
  IMG_8907: { latin: 'Duo in foliis', common: 'Pair among leaves' },
  IMG_8934: { latin: 'Saltatores autumnales', common: 'Autumn jumpers', note: 'airborne ↑' },
};
const fmt = (d?: string) =>
  d ? new Date(d + 'T12:00:00').toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) : '';

const specimens = photos.map((p) => ({
  id: p.id,
  src: p.thumb,
  srcset: p.srcset,
  alt: p.alt,
  portrait: p.portrait,
  latin: names[p.id]?.latin ?? 'Species incognita',
  common: `${names[p.id]?.common ?? p.alt} · ${fmt(p.date)}`,
  note: names[p.id]?.note,
}));

const observations = [
  {
    date: 'Obs. 01',
    title: 'The Tree of Life',
    habitat: 'Canvas 2D, in the browser',
    diet: '31 species, 10 traits',
    behaviour: 'Lights up every lineage that independently evolved flight, venom, echolocation…',
    href: '/tree-of-life',
  },
  {
    date: 'Obs. 02',
    title: 'Local RAG Assistant',
    habitat: 'macOS & iOS — strictly on-device',
    diet: 'iMessage history',
    behaviour: 'Answers questions about your texts. Never leaves its burrow (100% offline).',
  },
  {
    date: 'Obs. 03',
    title: 'jasonwride.studio',
    habitat: 'Cloudflare’s edge',
    diet: 'Astro, Svelte, WebGL',
    behaviour: 'Molts into a new design every few weeks. Currently in its notebook phase.',
    href: 'https://github.com/twitterspree/jasonwride-studio',
  },
];
---

<Concept
  title="Field Notes"
  current="field-notes"
  fonts="family=Kalam:wght@400;700&family=Courier+Prime:wght@400;700&family=Libre+Caslon+Text:ital,wght@0,400;0,700;1,400"
>
  <div class="notebook">
    <nav class="index-tabs" aria-label="Sections">
      <a href="#observer" style="--c:#f6e7a8">Observer</a>
      <a href="#specimens" style="--c:#cfe6c2">Specimens</a>
      <a href="#cladogram" style="--c:#f3cbb8">Tree</a>
      <a href="#log" style="--c:#c9dbef">Log</a>
    </nav>

    <header id="observer" class="page cover" data-skill-bounds>
      <div class="cover-text">
        <p class="typed">FIELD NOTEBOOK — VOL. 1 · PROPERTY OF</p>
        <h1 class="name">Jason Wride</h1>
        <p class="typed">If found, please return to <a href="mailto:jason.wride@utah.edu">jason.wride@utah.edu</a></p>
        <p class="hand intro">
          Information Systems student, University of Utah. Observing people in golden light & software in its natural
          habitat. <span class="squiggle">Click the page — it’s autumn.</span>
        </p>
        <p class="typed kit">EQUIPMENT CARRIED ↓ <span class="hand">(throw it around)</span></p>
        <DraggableSkills client:visible />
      </div>

      <figure class="taped">
        <span class="tape t1" aria-hidden="true"></span>
        <span class="tape t2" aria-hidden="true"></span>
        <div class="taped-photo">
          <DepthProfile client:load {...portrait} alt="Portrait of Jason Wride" />
        </div>
        <figcaption>
          <em>Jasonus wridei</em> — the observer.<br />
          <span class="hand">moves when you look at him ↑</span>
        </figcaption>
      </figure>
    </header>

    <section id="specimens" class="page">
      <h2 class="heading"><span class="typed">§1</span> Specimens collected</h2>
      <p class="hand sub">
        Pinned & labelled. Brush past them with your cursor, or flick one. All taken with a {CAMERA} + {LENS}.
      </p>
      <PinnedSpecimens client:visible {specimens} />
    </section>

    <section id="cladogram" class="page">
      <h2 class="heading"><span class="typed">§2</span> Who’s related to whom</h2>
      <p class="hand sub">Sketched from the Tree of Life project. Traits that evolved more than once are the interesting ones.</p>
      <FieldCladogram client:visible {treeData} {traitInfo} />
    </section>

    <section id="log" class="page">
      <h2 class="heading"><span class="typed">§3</span> Observation log — software</h2>
      <div class="log">
        {observations.map((o) => (
          <article class="entry">
            <p class="typed stamp">{o.date}</p>
            <h3>{o.title}</h3>
            <dl>
              <dt>Habitat</dt><dd>{o.habitat}</dd>
              <dt>Diet</dt><dd>{o.diet}</dd>
              <dt>Behaviour</dt><dd>{o.behaviour}</dd>
            </dl>
            {o.href && <a class="hand go" href={o.href}>go observe it →</a>}
          </article>
        ))}
      </div>
    </section>

    <footer class="page end">
      <p class="hand big">Seen something interesting? <a href="mailto:jason.wride@utah.edu">Report a sighting →</a></p>
      <p class="typed">— END OF VOL. 1 —</p>
    </footer>
  </div>
</Concept>

<script>
  // Click anywhere empty and an autumn leaf drifts down from that spot
  const COLORS = ['#c8641e', '#d99a2b', '#a33b1f', '#b87a2a', '#8c5a1c'];
  const LEAF =
    'M12 1c3 4 7 5 9 9-2 1-4 1-5 3 2 1 3 3 3 5-3 0-5-1-6-3-1 2-1 4-1 7h-1c0-3 0-5-1-7-1 2-3 3-6 3 0-2 1-4 3-5-1-2-3-2-5-3 2-4 6-5 9-9z';
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  document.addEventListener('click', (e) => {
    if (reduced) return;
    const t = e.target as HTMLElement;
    if (t.closest('a, button, input, svg, img, .taped, .concept-switcher')) return;
    const leaf = document.createElementNS('http://www.w3.org/2000/svg', 'svg');
    leaf.setAttribute('viewBox', '0 0 24 26');
    leaf.setAttribute('aria-hidden', 'true');
    leaf.classList.add('falling-leaf');
    leaf.innerHTML = `<path d="${LEAF}" fill="${COLORS[Math.floor(Math.random() * COLORS.length)]}"/>`;
    document.body.appendChild(leaf);

    let y = e.clientY;
    const x0 = e.clientX;
    let t0 = performance.now();
    const phase = Math.random() * Math.PI * 2;
    const size = 18 + Math.random() * 14;
    leaf.style.width = `${size}px`;
    const fall = (now: number) => {
      const dt = (now - t0) / 1000;
      y += 1.4;
      const sway = Math.sin(dt * 2.2 + phase) * 40;
      const rot = Math.sin(dt * 2.2 + phase) * 35 + dt * 20;
      leaf.style.transform = `translate(${x0 + sway - size / 2}px, ${y}px) rotate(${rot}deg)`;
      if (y < window.innerHeight + 40) requestAnimationFrame(fall);
      else leaf.remove();
    };
    requestAnimationFrame(fall);
  });
</script>

<style is:global>
  :root {
    --paper: #f4efe1;
    --ink: #2a2620;
    --graphite: #4b4538;
    --blue-ink: #2c5a8c;
    --rust: #9b3d1e;
    --bg-base: var(--paper);
    --text-base: var(--ink);
    --card-bg: #fffdf7;
    --border-subtle: rgba(0, 0, 0, 0.15);
    --shadow-soft: 2px 3px 0 rgba(75, 69, 56, 0.35);
    --accent-color: #2f8a3e;
    --accent-glow: rgba(47, 138, 62, 0.3);
  }
  body {
    background-color: #d8cfb8;
    color: var(--ink);
    font-family: 'Libre Caslon Text', Georgia, serif;
  }
  .falling-leaf {
    position: fixed;
    left: 0;
    top: 0;
    z-index: 8000;
    pointer-events: none;
    filter: drop-shadow(1px 2px 1px rgba(0, 0, 0, 0.2));
  }
  a { color: var(--blue-ink); }
</style>

<style>
  .notebook {
    position: relative;
    max-width: 1080px;
    margin: 2rem auto 7rem;
    padding: 0 1rem;
  }

  /* Coloured index tabs sticking out of the notebook's right edge */
  .index-tabs {
    position: fixed;
    right: 0;
    top: 30%;
    z-index: 50;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  .index-tabs a {
    background: var(--c);
    color: var(--ink);
    text-decoration: none;
    font: 700 0.8rem 'Courier Prime', monospace;
    padding: 0.5rem 0.7rem 0.5rem 1rem;
    border-radius: 6px 0 0 6px;
    box-shadow: -2px 2px 4px rgba(0, 0, 0, 0.12);
    transform: translateX(8px);
    transition: transform 0.2s cubic-bezier(0.3, 1.7, 0.5, 1);
  }
  .index-tabs a:hover { transform: translateX(0); }

  /* Graph-paper pages */
  .page {
    background-color: var(--paper);
    background-image:
      linear-gradient(rgba(44, 90, 140, 0.09) 1px, transparent 1px),
      linear-gradient(90deg, rgba(44, 90, 140, 0.09) 1px, transparent 1px);
    background-size: 22px 22px;
    padding: 3rem clamp(1.2rem, 4vw, 3.5rem);
    margin-bottom: 1.5rem;
    box-shadow: 0 1px 0 #c9bfa5, 0 3px 0 #efe9d8, 0 4px 0 #c9bfa5, 0 12px 30px rgba(60, 45, 20, 0.2);
    position: relative;
  }
  /* red margin line */
  .page::before {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    left: clamp(0.6rem, 2vw, 1.8rem);
    width: 1px;
    background: rgba(179, 38, 30, 0.35);
  }

  .typed { font-family: 'Courier Prime', monospace; font-size: 0.78rem; letter-spacing: 0.06em; color: var(--graphite); }
  .hand { font-family: 'Kalam', cursive; color: var(--blue-ink); }

  .cover { display: grid; grid-template-columns: 1.3fr 1fr; gap: 3rem; align-items: center; min-height: 80vh; }
  .name {
    font-family: 'Kalam', cursive;
    font-weight: 700;
    font-size: clamp(3.5rem, 10vw, 7rem);
    line-height: 0.95;
    color: var(--ink);
    margin: 0.4rem 0 0.8rem;
    transform: rotate(-2deg);
    /* double-underlined in pen */
    text-decoration: underline double var(--blue-ink);
    text-underline-offset: 10px;
    text-decoration-thickness: 2px;
  }
  .intro { font-size: 1.3rem; line-height: 1.5; margin: 1.5rem 0; max-width: 34ch; }
  .squiggle { text-decoration: underline wavy #c8641e; text-underline-offset: 5px; color: #9b3d1e; }
  .kit { margin: 2rem 0 0.8rem; }
  .kit .hand { font-size: 1rem; letter-spacing: 0; }

  .taped { position: relative; transform: rotate(2.5deg); }
  .taped-photo { height: 420px; background: #fffdf7; padding: 12px; box-shadow: 3px 10px 24px rgba(60, 45, 20, 0.25); }
  .taped-photo :global(.depth-container) { border-radius: 0; }
  .tape {
    position: absolute;
    z-index: 2;
    width: 110px;
    height: 30px;
    background: rgba(240, 230, 190, 0.75);
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.1);
  }
  .t1 { top: -12px; left: -20px; transform: rotate(-35deg); }
  .t2 { top: -12px; right: -20px; transform: rotate(35deg); }
  .taped figcaption { margin-top: 0.8rem; text-align: center; font-size: 1.05rem; }
  .taped figcaption .hand { font-size: 0.95rem; }

  .heading {
    font-family: 'Libre Caslon Text', serif;
    font-weight: 400;
    font-size: clamp(2rem, 5vw, 3rem);
    display: flex;
    align-items: baseline;
    gap: 0.8rem;
  }
  .heading .typed { font-size: 0.9rem; color: var(--rust); }
  .sub { font-size: 1.1rem; margin-top: 0.3rem; }

  .log { display: grid; grid-template-columns: repeat(auto-fit, minmax(270px, 1fr)); gap: 2rem; margin-top: 2rem; }
  .entry {
    background: #fffdf7;
    padding: 1.3rem 1.3rem 1.5rem;
    box-shadow: 2px 4px 10px rgba(60, 45, 20, 0.15);
    transform: rotate(var(--r, -0.6deg));
    transition: transform 0.25s cubic-bezier(0.3, 1.6, 0.5, 1);
  }
  .entry:nth-child(2) { --r: 0.8deg; }
  .entry:hover { transform: rotate(0) translateY(-4px); }
  .stamp { color: var(--rust); border: 1.5px solid var(--rust); display: inline-block; padding: 0.05rem 0.4rem; transform: rotate(-3deg); }
  .entry h3 { font-size: 1.5rem; font-weight: 700; margin: 0.6rem 0; }
  dl { display: grid; grid-template-columns: auto 1fr; gap: 0.3rem 0.8rem; font-size: 0.92rem; line-height: 1.45; }
  dt { font-family: 'Courier Prime', monospace; font-size: 0.72rem; text-transform: uppercase; color: var(--graphite); padding-top: 0.2rem; }
  .go { display: inline-block; margin-top: 1rem; font-size: 1.1rem; }

  .end { text-align: center; }
  .big { font-size: clamp(1.4rem, 4vw, 2.2rem); margin-bottom: 1rem; }

  @media (max-width: 820px) {
    .cover { grid-template-columns: 1fr; }
    .taped { order: -1; max-width: 400px; margin: 0 auto; }
    .taped-photo { height: 340px; }
    .index-tabs { display: none; }
  }
</style>
