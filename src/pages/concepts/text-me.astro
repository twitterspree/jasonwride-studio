---
import Concept from '../../layouts/Concept.astro';
import TextThread from '../../components/concepts/TextThread.svelte';
import { loadPhotos } from '../../lib/photos';
import { loadLandscapes } from '../../lib/landscapes';
import { loadPortrait } from '../../lib/portrait';
import stats from '../../data/exposure-stats.json';

const portrait = await loadPortrait();
const portraits = (await loadPhotos(600)).map((p) => ({ id: p.id, src: p.full, alt: p.alt }));
const landscapes = (await loadLandscapes())
  .filter((l) => ['IMG_0591', 'IMG_2109', 'IMG_2090', 'IMG_0489-2'].includes(l.id))
  .map((l) => ({ id: l.id, src: l.thumb, alt: l.alt }));

// Facts Jason "texts" — computed from the aggregate EXIF stats
const P = stats.people;
const pct = (n: number) => Math.round((n / P.photos) * 100);
const facts = {
  photos: P.photos,
  sessions: P.sessions,
  medianAperture: P.medianAperture,
  saturdayPct: pct(P.weekdays['6'] ?? 0),
  lateAfternoonPct: pct((P.hours['16'] ?? 0) + (P.hours['17'] ?? 0) + (P.hours['18'] ?? 0)),
};
---

<Concept title="Text Me" current="text-me" dock="top" fonts="family=Caveat:wght@600">
  <div class="stage">
    <aside class="aside">
      <p class="hand">psst — this whole website is a text thread.</p>
      <p class="small">Tap a reply, or type anything. Double-click a bubble to react. Best on your phone.</p>
    </aside>
    <TextThread client:load avatar={portrait.src} {portraits} {landscapes} {facts} />
  </div>
</Concept>

<style is:global>
  body {
    min-height: 100dvh;
    background:
      radial-gradient(ellipse at 20% 10%, rgba(10, 132, 255, 0.25), transparent 55%),
      radial-gradient(ellipse at 90% 90%, rgba(255, 159, 10, 0.18), transparent 55%),
      #e9e6e0;
    font-family: -apple-system, BlinkMacSystemFont, system-ui, sans-serif;
  }
  @media (prefers-color-scheme: dark) {
    body {
      background:
        radial-gradient(ellipse at 20% 10%, rgba(10, 132, 255, 0.25), transparent 55%),
        radial-gradient(ellipse at 90% 90%, rgba(255, 159, 10, 0.12), transparent 55%),
        #121214;
      color: #eee;
    }
  }
</style>

<style>
  .stage { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; min-height: 100dvh; }
  .stage :global(.phone) { grid-column: 2; grid-row: 1; }
  .aside { grid-column: 1; grid-row: 1; justify-self: end; max-width: 240px; margin-right: 3rem; transform: rotate(-3deg); }
  .hand { font: 600 1.7rem/1.1 'Caveat', cursive; }
  .small { margin-top: 0.6rem; font-size: 0.85rem; opacity: 0.7; line-height: 1.4; }
  @media (max-width: 980px) {
    .stage { display: block; }
    .aside { display: none; }
  }
</style>
